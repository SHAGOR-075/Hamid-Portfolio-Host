MONGODB_URI=mongodb+srv://your-user:your-password@cluster.mongodb.net/portfolio_db
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_EMAIL=your-email@gmail.com
ADMIN_PASSWORD=replace_with_strong_password
CLIENT_ORIGIN=https://your-portfolio-site.com
ADMIN_ORIGIN=https://your-admin-site.com

# Gmail SMTP (use App Password, not normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your_gmail_app_password
NOTIFICATION_RECEIVER_EMAIL=your-email@gmail.com
